# Local editor and OS files
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
*.log

# Dart / Flutter caches and build output
.dart_tool/
.packages
.pub/
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
**/doc/api/
app.*.symbols
app.*.map.json

# Android machine configuration and signing secrets
.gradle/
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# Apple generated files and user configuration
**/Pods/
**/.symlinks/
**/DerivedData/
**/xcuserdata/
**/*.xcuserstate
**/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/.last_build_id
**/ios/Runner/GeneratedPluginRegistrant.*

# Private runtime data; synthetic test fixtures are explicitly allowed
*.sqlite
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm
/backups/
/runtime-data/
!test/fixtures/**/*.sqlite
!test/fixtures/**/*.sqlite3
!test/fixtures/**/*.db

# Keep application dependency lockfiles and platform build wrappers tracked.
# Do not ignore pubspec.lock, *.g.dart, Gradle wrappers or migration snapshots.

# Project-local SDK and caches
.tooling/

